{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Top level = LOCAL DEVELOPMENT and tests only (`npm run dev`, CI). Nothing
	// here is ever deployed; its data lives on the laptop (.wrangler/state).
	// The ONLY real environment is `env.production` (decided 8 Nov 2026:
	// production only, no staging). Build it with CLOUDFLARE_ENV=production.
	"name": "arabsstartups-local",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"d1_databases": [{ "binding": "DB", "database_name": "arabsstartups-local" }],
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "arabsstartups-media-local" }],
	"triggers": { "crons": ["* * * * *"] },
	"vars": {
		"INQUIRY_RETENTION_DAYS": "365",
	},
	"env": {
		"production": {
			"name": "arabsstartups",
			"workers_dev": false,
			// One public address only: no *.workers.dev copies of the site.
			"preview_urls": false,
			"observability": { "enabled": true },
			// database_id: printed by `npx wrangler d1 create arabsstartups-prod` (RUNBOOK §2).
			"d1_databases": [{ "binding": "DB", "database_name": "arabsstartups-prod" }],
			// Public media only. Backups go to a SEPARATE private bucket (docs/OPERATIONS.md → Backups).
			"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "arabsstartups-media-prod" }],
			"triggers": { "crons": ["* * * * *"] },
			"routes": [
				{ "pattern": "arabsstartups.com", "custom_domain": true },
				{ "pattern": "www.arabsstartups.com", "custom_domain": true },
			],
			// Secrets (wrangler secret put <NAME> --env production):
			//   EMDASH_ENCRYPTION_KEY, CF_ACCESS_AUDIENCE, TURNSTILE_SECRET_KEY, RESEND_API_KEY
			"vars": {
				"EMDASH_SITE_URL": "https://arabsstartups.com",
				"CF_ACCESS_TEAM_DOMAIN": "arabsstartups.cloudflareaccess.com",
				"PUBLIC_TURNSTILE_SITE_KEY": "CHANGE-ME",
				"TURNSTILE_ALLOWED_HOSTNAMES": "arabsstartups.com,www.arabsstartups.com",
				"MAIL_FROM": "Arabs Startups <hello@arabsstartups.com>",
				"MAIL_REPLY_TO": "hello@arabsstartups.com",
				"EDITORIAL_ALERT_EMAIL": "",
				"INQUIRY_RETENTION_DAYS": "365",
				"PUBLIC_CF_BEACON_TOKEN": "",
			},
		},
	},
}

# Copy to .env for LOCAL development only. Never commit .env.
# Production values are Worker vars (wrangler.jsonc) and
# Worker secrets (`wrangler secret put <NAME> --env production`).

# Encrypts CMS plugin secrets. Generate with: npm run secrets:generate -- --write=.env
EMDASH_ENCRYPTION_KEY=

# Cloudflare Turnstile. Locally use Cloudflare's public TEST keys (always pass):
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Production: comma-separated hostnames the token must be issued for.
# Leave empty locally (test tokens report "example.com").
TURNSTILE_ALLOWED_HOSTNAMES=

# Outbound email. Without RESEND_API_KEY, local dev writes mail to a dev outbox
# table and production refuses to send (replies show "email not configured").
RESEND_API_KEY=
MAIL_FROM=Arabs Startups Dev <dev@arabsstartups.test>
MAIL_REPLY_TO=dev@arabsstartups.test
# Fallback address for new-message alerts when no staff member opted in.
EDITORIAL_ALERT_EMAIL=

# How long contact messages are kept before automatic deletion.
INQUIRY_RETENTION_DAYS=365

# Production only (Cloudflare Access). Not used by `astro dev`.
# CF_ACCESS_TEAM_DOMAIN=arabsstartups.cloudflareaccess.com
# CF_ACCESS_AUDIENCE=<Application Audience (AUD) tag>

# Optional Cloudflare Web Analytics beacon token.
PUBLIC_CF_BEACON_TOKEN=

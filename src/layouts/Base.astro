---
/**
 * Public page layout. SEO tags (description, canonical, Open Graph, Twitter,
 * JSON-LD, hreflang for content) are rendered by EmDash's <EmDashHead>, which
 * escapes them safely — we do not hand-roll them.
 */
import "../styles/global.css";
import { Font } from "astro:assets";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { LOCALE_META, alternatePath, localeFromPath, t, type Locale } from "../i18n";
import { getConfig } from "../lib/config";
import { hasEpisodes } from "../lib/content/queries";

interface Props {
	title: string;
	description?: string;
	locale?: Locale;
	type?: "website" | "article";
	image?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	noindex?: boolean;
	/** Other-language URL. `false` = no translation exists. Defaults to the mirrored path. */
	alternate?: string | false;
}

const props = Astro.props;
const locale: Locale = props.locale ?? localeFromPath(Astro.url.pathname);
const dict = t(locale);
const fullTitle =
	props.title === dict.siteName || props.title.includes(dict.siteName)
		? props.title
		: `${props.title} — ${dict.siteName}`;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const alternate = props.alternate === undefined ? alternatePath(Astro.url.pathname).path : props.alternate;
const otherLocale: Locale = locale === "ar" ? "en" : "ar";

const pageCtx = createPublicPageContext({
	Astro,
	kind: props.content ? "content" : "custom",
	pageType: props.type ?? "website",
	title: fullTitle,
	pageTitle: props.title,
	description: props.description ?? dict.home.description,
	canonical,
	image: props.image ?? null,
	content: props.content,
	articleMeta: {
		publishedTime: props.publishedTime ?? undefined,
		modifiedTime: props.modifiedTime ?? undefined,
		author: props.author ?? undefined,
	},
	siteName: dict.siteName,
});

const showEpisodes = await hasEpisodes(locale);
const beaconToken = getConfig().beaconToken;
const beacon = beaconToken ? JSON.stringify({ token: beaconToken }) : null;
---

<!doctype html>
<html lang={locale} dir={LOCALE_META[locale].dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<Font
			cssVariable="--font-ar"
			preload={[
				{ subset: "arabic", weight: "400" },
				{ subset: "arabic", weight: "700" },
			]}
		/>
		<Font cssVariable="--font-latin" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="alternate" type="application/rss+xml" title={dict.siteName} href="/rss.xml" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#000012" media="(prefers-color-scheme: dark)" />
		<meta property="og:locale" content={LOCALE_META[locale].ogLocale} />
		{props.noindex && <meta name="robots" content="noindex, nofollow" />}
		{
			!props.content && alternate && (
				<>
					<link rel="alternate" hreflang={locale} href={canonical} />
					<link rel="alternate" hreflang={otherLocale} href={new URL(alternate, site).href} />
					<link
						rel="alternate"
						hreflang="x-default"
						href={locale === "ar" ? canonical : new URL(alternate, site).href}
					/>
				</>
			)
		}
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip-link">{dict.skipToContent}</a>
		<Header locale={locale} showEpisodes={showEpisodes} alternate={alternate || null} />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<Footer locale={locale} />
		{
			beacon && (
				<script
					is:inline
					defer
					src="https://static.cloudflareinsights.com/beacon.min.js"
					data-cf-beacon={beacon}
				/>
			)
		}
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>

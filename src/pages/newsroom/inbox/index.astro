---
import Newsroom from "../../../layouts/Newsroom.astro";
import { formatDate, t } from "../../../i18n";
import { STATUS_LABELS } from "../../../lib/inbox/labels";
import { listInquiries } from "../../../lib/inbox/repo";
import { INQUIRY_CATEGORIES, INQUIRY_STATUSES, type InquiryCategory, type InquiryStatus } from "../../../lib/inbox/validation";
import { getDb, requireStaff } from "../../../lib/runtime";
import { denyResponse } from "../../../lib/staff/deny";
import { flashFrom } from "../../../lib/staff/forms";
import { can } from "../../../lib/staff/roles";

export const prerender = false;

const decision = await requireStaff(Astro, "inbox:read");
if (!decision.ok) return denyResponse(decision);
const { user } = decision;
const db = await getDb();
const dict = t("ar");

const params = Astro.url.searchParams;
const statusParam = params.get("status") ?? "open";
const statuses: InquiryStatus[] =
	statusParam === "open"
		? ["new", "in_progress"]
		: statusParam === "all"
			? []
			: (INQUIRY_STATUSES as readonly string[]).includes(statusParam)
				? [statusParam as InquiryStatus]
				: ["new", "in_progress"];
const categoryParam = params.get("category") ?? "";
const category = (INQUIRY_CATEGORIES as readonly string[]).includes(categoryParam)
	? (categoryParam as InquiryCategory)
	: "";
const q = (params.get("q") ?? "").slice(0, 100);
const page = Math.max(1, Number.parseInt(params.get("page") ?? "1", 10) || 1);
const limit = 25;
const { items, total } = await listInquiries(db, { statuses, category, q, limit, offset: (page - 1) * limit });
const pages = Math.max(1, Math.ceil(total / limit));
const flash = flashFrom(Astro.url);
const query = (extra: Record<string, string>) => {
	const next = new URLSearchParams({ status: statusParam, category, q, ...extra });
	for (const [key, value] of [...next.entries()]) if (!value) next.delete(key);
	return `?${next.toString()}`;
};
---

<Newsroom title="صندوق الرسائل" user={user}>
	{flash && <p class="notice flash" role="status">{flash.text}</p>}
	<form method="get" class="filters-row" role="search">
		<div class="field">
			<label for="status">الحالة</label>
			<select id="status" name="status">
				<option value="open" selected={statusParam === "open"}>المفتوحة (جديدة + قيد المتابعة)</option>
				<option value="all" selected={statusParam === "all"}>الكل</option>
				{INQUIRY_STATUSES.map((s) => <option value={s} selected={statusParam === s}>{STATUS_LABELS[s]}</option>)}
			</select>
		</div>
		<div class="field">
			<label for="category">النوع</label>
			<select id="category" name="category">
				<option value="">كل الأنواع</option>
				{INQUIRY_CATEGORIES.map((c) => <option value={c} selected={category === c}>{dict.contact.categories[c]}</option>)}
			</select>
		</div>
		<div class="field">
			<label for="q">بحث</label>
			<input id="q" name="q" type="search" value={q} maxlength="100" placeholder="الموضوع أو الاسم أو البريد" />
		</div>
		<button class="btn btn-primary btn-sm" type="submit">تصفية</button>
		{
			can(user, "inbox:export") && (
				<a class="btn btn-secondary btn-sm" href={`/newsroom/export.csv${query({})}`}>
					تصدير CSV
				</a>
			)
		}
	</form>

	<p class="help"><span class="num">{total}</span> رسالة</p>
	<div class="table-wrap">
		<table class="table">
			<thead>
				<tr>
					<th scope="col">التاريخ</th>
					<th scope="col">الموضوع</th>
					<th scope="col">المرسل</th>
					<th scope="col">النوع</th>
					<th scope="col">الحالة</th>
				</tr>
			</thead>
			<tbody>
				{
					items.length === 0 ? (
						<tr>
							<td colspan="5">لا توجد رسائل مطابقة.</td>
						</tr>
					) : (
						items.map((item) => (
							<tr class:list={{ unread: item.is_read === 0 }}>
								<td><time datetime={item.created_at}>{formatDate(item.created_at, "ar", true)}</time></td>
								<td><a href={`/newsroom/inbox/${item.id}`}>{item.subject}</a></td>
								<td>
									{item.name}
									<br />
									<span class="ltr help">{item.email}</span>
								</td>
								<td>{dict.contact.categories[item.category]}</td>
								<td><span class:list={["badge", { "status-new": item.status === "new" }]}>{STATUS_LABELS[item.status]}</span></td>
							</tr>
						))
					)
				}
			</tbody>
		</table>
	</div>
	{
		pages > 1 && (
			<nav class="pager" aria-label="صفحات">
				{page > 1 ? <a href={query({ page: String(page - 1) })}>السابق</a> : <span />}
				<span class="num">{page} / {pages}</span>
				{page < pages ? <a href={query({ page: String(page + 1) })}>التالي</a> : <span />}
			</nav>
		)
	}
</Newsroom>

---
import Logo from "./Logo.astro";
import LinkedInLink from "./LinkedInLink.astro";
import { localePath, t, type Locale } from "../i18n";

interface Props {
	locale: Locale;
	/** Slugs of published CMS pages; links to other pages are hidden. */
	pages: Set<string>;
	/** Sections with published posts in this language; empty ones are hidden. */
	sections: { news: boolean; stories: boolean };
	siteName: string;
	/** Footer line under the logo (CMS Settings → Tagline on Arabic pages). */
	mission: string;
}
const { locale, pages, sections, siteName, mission } = Astro.props;
const dict = t(locale);
const year = new Date().getFullYear();
const L = (path: string) => localePath(locale, path);
const page = (slug: string, label: string) => (pages.has(slug) ? [{ href: L(`/${slug}`), label }] : []);

const columns = [
	{
		title: dict.footer.content,
		links: [
			...(sections.news ? [{ href: L("/news"), label: dict.nav.news }] : []),
			...(sections.stories ? [{ href: L("/stories"), label: dict.nav.stories }] : []),
			...page("about", dict.nav.about),
			{ href: L("/contact"), label: dict.nav.contact },
			...page("submit-news", dict.footer.submit),
			{ href: L("/feed"), label: dict.footer.rss },
		],
	},
	{
		title: dict.footer.policies,
		links: [
			...page("privacy", dict.footer.privacy),
			...page("terms", dict.footer.terms),
			...page("editorial-policy", dict.footer.editorial),
			...page("corrections", dict.footer.corrections),
			...page("disclosure", dict.footer.disclosure),
			...page("comment-policy", dict.footer.commentPolicy),
		],
	},
].filter((column) => column.links.length > 0);
---

<footer class="site-footer">
	<div class="container footer-inner">
		<div class="footer-brand">
			<a href={L("/")} class="logo-link" aria-label={siteName}>
				<Logo variant="wordmark" />
			</a>
			<p class="footer-mission">{mission}</p>
			<div class="footer-social">
				<span class="footer-social-label">{dict.social.followUs}</span>
				<LinkedInLink locale={locale} />
			</div>
		</div>
		{
			columns.map((column) => (
				<nav class="footer-col" aria-label={column.title}>
					<h2 class="footer-col-title">{column.title}</h2>
					<ul>
						{column.links.map((link) => (
							<li>
								<a href={link.href}>{link.label}</a>
							</li>
						))}
					</ul>
				</nav>
			))
		}
	</div>
	<div class="container footer-bottom">
		<p>
			© <span class="ltr">{year}</span> Arabs Startups — {dict.footer.rights}
		</p>
		<p>{dict.footer.independent}</p>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--muted-bg);
		border-block-start: 1px solid var(--border);
		margin-block-start: var(--space-3xl);
	}
	.footer-inner {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: var(--space-2xl);
		padding-block: var(--space-3xl) var(--space-xl);
	}
	.logo-link {
		text-decoration: none;
	}
	.footer-mission {
		color: var(--muted-fg);
		margin-block-start: var(--space-md);
		max-width: 42ch;
	}
	.footer-social {
		display: flex;
		align-items: center;
		gap: var(--space-md);
		margin-block-start: var(--space-lg);
	}
	.footer-social-label {
		font-size: var(--fs-small);
		font-weight: 700;
		color: var(--muted-fg);
	}
	.footer-col-title {
		font-size: var(--fs-small);
		letter-spacing: 0.04em;
		color: var(--muted-fg);
		margin-block-end: var(--space-md);
	}
	.footer-col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-sm);
	}
	.footer-col a {
		color: var(--fg);
		text-decoration: none;
	}
	.footer-col a:hover {
		color: var(--accent);
		text-decoration: underline;
	}
	.footer-bottom {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: var(--space-sm);
		padding-block: var(--space-lg);
		border-block-start: 1px solid var(--border);
		font-size: var(--fs-small);
		color: var(--muted-fg);
	}
	.footer-bottom p {
		margin: 0;
	}
	@media (max-width: 760px) {
		.footer-inner {
			grid-template-columns: 1fr 1fr;
		}
		.footer-brand {
			grid-column: 1 / -1;
		}
	}
</style>

---
import Logo from "./Logo.astro";
import { localePath, t, type Locale } from "../i18n";

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const dict = t(locale);
const year = new Date().getFullYear();
const L = (path: string) => localePath(locale, path);

const columns = [
	{
		title: dict.footer.content,
		links: [
			{ href: L("/news"), label: dict.nav.news },
			{ href: L("/stories"), label: dict.nav.stories },
			{ href: L("/about"), label: dict.nav.about },
			{ href: L("/contact"), label: dict.nav.contact },
			{ href: L("/submit-news"), label: dict.footer.submit },
			{ href: "/rss.xml", label: "RSS" },
		],
	},
	{
		title: dict.footer.policies,
		links: [
			{ href: L("/privacy"), label: dict.footer.privacy },
			{ href: L("/terms"), label: dict.footer.terms },
			{ href: L("/editorial-policy"), label: dict.footer.editorial },
			{ href: L("/corrections"), label: dict.footer.corrections },
			{ href: L("/disclosure"), label: dict.footer.disclosure },
			{ href: L("/comment-policy"), label: dict.footer.commentPolicy },
		],
	},
];
---

<footer class="site-footer">
	<div class="container footer-inner">
		<div class="footer-brand">
			<a href={L("/")} class="logo-link" aria-label={dict.siteName}>
				<Logo variant="wordmark" />
			</a>
			<p class="footer-mission">{dict.footer.mission}</p>
		</div>
		{
			columns.map((column) => (
				<nav class="footer-col" aria-label={column.title}>
					<h2 class="footer-col-title">{column.title}</h2>
					<ul>
						{column.links.map((link) => (
							<li>
								<a href={link.href}>{link.label}</a>
							</li>
						))}
					</ul>
				</nav>
			))
		}
	</div>
	<div class="container footer-bottom">
		<p>
			© <span class="ltr">{year}</span> Arabs Startups — {dict.footer.rights}
		</p>
		<p>{dict.footer.independent}</p>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--muted-bg);
		border-block-start: 1px solid var(--border);
		margin-block-start: var(--space-3xl);
	}
	.footer-inner {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: var(--space-2xl);
		padding-block: var(--space-3xl) var(--space-xl);
	}
	.logo-link {
		text-decoration: none;
	}
	.footer-mission {
		color: var(--muted-fg);
		margin-block-start: var(--space-md);
		max-width: 42ch;
	}
	.footer-col-title {
		font-size: var(--fs-small);
		letter-spacing: 0.04em;
		color: var(--muted-fg);
		margin-block-end: var(--space-md);
	}
	.footer-col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-sm);
	}
	.footer-col a {
		color: var(--fg);
		text-decoration: none;
	}
	.footer-col a:hover {
		color: var(--accent);
		text-decoration: underline;
	}
	.footer-bottom {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: var(--space-sm);
		padding-block: var(--space-lg);
		border-block-start: 1px solid var(--border);
		font-size: var(--fs-small);
		color: var(--muted-fg);
	}
	.footer-bottom p {
		margin: 0;
	}
	@media (max-width: 760px) {
		.footer-inner {
			grid-template-columns: 1fr 1fr;
		}
		.footer-brand {
			grid-column: 1 / -1;
		}
	}
</style>

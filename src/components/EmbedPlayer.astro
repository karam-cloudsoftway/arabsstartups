---
/** Player for allow-listed providers only; anything else becomes a plain link. */
import { toEmbed } from "../lib/content/embeds";

interface Props {
	url: string;
	title: string;
	linkLabel: string;
}
const { url, title, linkLabel } = Astro.props;
const embed = toEmbed(url, title);
const safeLink = /^https:\/\//.test(url) ? url : null;
---

{
	embed && (
		<div class:list={["player", embed.aspect]}>
			<iframe
				src={embed.src}
				title={title}
				loading="lazy"
				referrerpolicy="strict-origin-when-cross-origin"
				allow="encrypted-media; picture-in-picture; fullscreen"
				allowfullscreen
				sandbox="allow-scripts allow-same-origin allow-popups allow-presentation"
			/>
		</div>
	)
}
{
	safeLink && (
		<p class="help">
			<a href={safeLink} target="_blank" rel="noopener noreferrer">
				{linkLabel}
			</a>
		</p>
	)
}

<style>
	.player {
		position: relative;
		width: 100%;
		background: var(--muted-bg);
		margin-block: var(--space-lg);
	}
	.player.video {
		aspect-ratio: 16 / 9;
	}
	.player.audio {
		height: 232px;
	}
	.player iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>

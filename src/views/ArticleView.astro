---
import { Image, PortableText } from "emdash/ui";
import ArticleCard from "../components/ArticleCard.astro";
import Comments from "../components/Comments.astro";
import Base from "../layouts/Base.astro";
import { formatDate, isoDate, localePath, t, type Locale } from "../i18n";
import { authorOf, entrySlug, listPosts, type EntryLike } from "../lib/content/queries";

interface Props {
	entry: EntryLike;
	locale: Locale;
	isPreview: boolean;
	alternate: string | false;
}
const { entry, locale, isPreview, alternate } = Astro.props;
const dict = t(locale);
const data = entry.data;
const slug = entrySlug(entry);
const title = String(data.title ?? "");
const excerpt = String(data.excerpt ?? "");
const category = data.terms?.category?.[0] ?? null;
const tags = data.terms?.tag ?? [];
const author = authorOf(entry);
const contentLabel = String(data.content_label ?? "news");
const flagged = ["opinion", "partner", "sponsored", "press_release"].includes(contentLabel);
const publishedAt = (data.publishedAt as Date | null | undefined) ?? null;
const updatedAt = (data.updatedAt as Date | undefined) ?? null;
const showUpdated =
	publishedAt && updatedAt && updatedAt.getTime() - publishedAt.getTime() > 60 * 60 * 1000;
const sourceUrl = typeof data.source_url === "string" && /^https?:\/\//.test(data.source_url) ? data.source_url : null;
const sourceName = typeof data.source_name === "string" ? data.source_name : "";
const corrections = typeof data.corrections === "string" ? data.corrections.trim() : "";
const commentsOpen = !isPreview && data.status === "published";

const site = Astro.site ?? new URL(Astro.url.origin);
const url = new URL(localePath(locale, `/articles/${slug}`), site).href;
const share = encodeURIComponent(url);
const shareText = encodeURIComponent(title);
const shareLinks = [
	{ label: "X", href: `https://twitter.com/intent/tweet?url=${share}&text=${shareText}` },
	{ label: "LinkedIn", href: `https://www.linkedin.com/sharing/share-offsite/?url=${share}` },
	{ label: "Facebook", href: `https://www.facebook.com/sharer/sharer.php?u=${share}` },
	{ label: "WhatsApp", href: `https://wa.me/?text=${shareText}%20${share}` },
	{ label: "Telegram", href: `https://t.me/share/url?url=${share}&text=${shareText}` },
];

const related = category
	? (await listPosts(locale, { limit: 4, category: category.slug })).cards.filter((card) => card.slug !== slug).slice(0, 3)
	: [];

const image = data.featured_image as { id?: string; src?: string } | undefined;
const ogImage = image?.src ? new URL(image.src, site).href : null;
---

<Base
	title={title}
	description={excerpt || dict.home.description}
	locale={locale}
	type="article"
	image={ogImage}
	content={{ collection: "posts", id: data.id, slug }}
	publishedTime={isoDate(publishedAt) ?? null}
	modifiedTime={isoDate(updatedAt) ?? null}
	author={author}
	noindex={isPreview}
	alternate={alternate}
>
	<article class="article section">
		<div class="container narrow">
			<div class="article-tags">
				{
					category && (
						<a class="slash-tag" href={localePath(locale, `/category/${category.slug}`)}>
							{category.label}
						</a>
					)
				}
				{flagged && <span class="badge badge-accent">{dict.labels[contentLabel]}</span>}
				{isPreview && <span class="badge badge-warn">Preview</span>}
			</div>
			<h1>{title}</h1>
			{excerpt && <p class="lead">{excerpt}</p>}

			<div class="meta">
				{author && <span>{dict.article.by} {author}</span>}
				{
					publishedAt && (
						<span>
							{dict.article.published} <time datetime={isoDate(publishedAt)}>{formatDate(publishedAt, locale)}</time>
						</span>
					)
				}
				{
					showUpdated && (
						<span>
							{dict.article.updated} <time datetime={isoDate(updatedAt)}>{formatDate(updatedAt, locale)}</time>
						</span>
					)
				}
			</div>

			{data.sample_content === true && <p class="notice">{dict.article.sampleNote}</p>}

			{
				image?.id && (
					<figure class="cover">
						<Image image={image as never} priority sizes="(max-width: 760px) 100vw, 720px" />
					</figure>
				)
			}

			<div class="prose">
				<PortableText value={(data.content as never) ?? []} />
			</div>

			{
				(sourceUrl || sourceName) && (
					<p class="source">
						{dict.article.source}:{" "}
						{sourceUrl ? (
							<a href={sourceUrl} rel="nofollow noopener noreferrer" target="_blank">
								{sourceName || new URL(sourceUrl).hostname}
							</a>
						) : (
							sourceName
						)}
					</p>
				)
			}

			{
				corrections && (
					<aside class="corrections notice" aria-label={dict.article.corrections}>
						<strong>{dict.article.corrections}:</strong> <span>{corrections}</span>
					</aside>
				)
			}

			{
				tags.length > 0 && (
					<ul class="tags" aria-label={dict.article.tags}>
						{tags.map((tag) => (
							<li>
								<a href={localePath(locale, `/tag/${tag.slug}`)}>{tag.label}</a>
							</li>
						))}
					</ul>
				)
			}

			<div class="share" aria-label={dict.article.share}>
				<span class="share-label">{dict.article.share}</span>
				{
					shareLinks.map((link) => (
						<a href={link.href} target="_blank" rel="noopener noreferrer nofollow">
							{link.label}
						</a>
					))
				}
				<button type="button" class="btn-link" data-copy-link={url} data-copied-label="✓">
					{dict.article.copyLink}
				</button>
			</div>

			<Comments contentId={data.id} locale={locale} open={commentsOpen} />
		</div>
	</article>

	{
		related.length > 0 && (
			<section class="section-tight" aria-labelledby="related-heading">
				<div class="container">
					<h2 id="related-heading" class="related-title">
						{dict.article.related}
					</h2>
					<div class="grid-cards">
						{related.map((card) => (
							<ArticleCard card={card} locale={locale} showImage={false} />
						))}
					</div>
				</div>
			</section>
		)
	}
</Base>

<style>
	.article-tags {
		display: flex;
		gap: var(--space-sm);
		align-items: center;
		flex-wrap: wrap;
	}
	.article h1 {
		font-size: var(--fs-h1);
		margin-block: var(--space-sm) var(--space-md);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm) var(--space-lg);
		font-size: var(--fs-small);
		color: var(--muted-fg);
		padding-block: var(--space-md);
		border-block: 1px solid var(--border);
		margin-block: var(--space-lg) var(--space-xl);
	}
	.cover {
		margin: 0 0 var(--space-xl);
	}
	.source {
		font-size: var(--fs-small);
		color: var(--muted-fg);
		margin-block-start: var(--space-xl);
	}
	.corrections {
		margin-block: var(--space-lg);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
		list-style: none;
		padding: 0;
		margin-block: var(--space-xl);
	}
	.tags a {
		display: inline-block;
		font-size: var(--fs-small);
		background: var(--muted-bg);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: var(--space-xs) var(--space-sm);
		color: var(--muted-fg);
		text-decoration: none;
	}
	.share {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm) var(--space-md);
		align-items: center;
		font-size: var(--fs-small);
		padding-block: var(--space-md);
		border-block-start: 1px solid var(--border);
	}
	.share a {
		color: var(--fg);
		font-weight: 600;
		min-height: 44px;
		display: inline-flex;
		align-items: center;
	}
	.share-label {
		color: var(--muted-fg);
	}
	.related-title {
		border-block-end: 2px solid var(--fg);
		padding-block-end: var(--space-sm);
	}
</style>
